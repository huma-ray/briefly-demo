# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: agent log writes, usage accounting and the nightly reset.
SUPABASE_SERVICE_ROLE_KEY=

# Public demo: the assistant answers 8 fixed questions with scripted replies (real tools, no model,
# no free text). A workspace whose Admin connects its own endpoint gets free chat back.
# Leave unset (false) for a real deployment.
DEMO_SCRIPTED=false

# Model provider (see lib/ai/provider.ts to switch to Claude)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: deployment-wide OpenAI-compatible default (e.g. LiteLLM / vLLM).
# When set, AI_MODEL is that server's model id and costs are recorded as 0.
AI_BASE_URL=
AI_API_KEY=

# Encrypts API keys that Admins save for a custom model endpoint (32+ random chars)
PROVIDER_KEY_SECRET=
# true only when this app runs on the same private network as its model server
ALLOW_PRIVATE_AI_ENDPOINTS=false

# Vercel cron calls /api/cron/reset with this bearer token
CRON_SECRET=

# Link in the demo strip
NEXT_PUBLIC_SOURCE_URL=https://github.com/huma-ray/briefly-demo
